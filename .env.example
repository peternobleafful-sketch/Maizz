# Names of the settings Maizz will need. NO real values in this file, ever.
# Real values go into the Vercel settings boxes (and GitHub secrets), never into the code or chat.

# Supabase (added in step 2)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack, TEST mode only until Kobina confirms the legal checks are done (step 3)
PAYSTACK_SECRET_KEY=

# Access token for the private /setup-check page (step 3). Make up a long random string, at least 24 characters.
# If this is not set, the setup page and test tools are switched off.
SETUP_CHECK_TOKEN=

# Do NOT set this until the company, bank account and legal checks are done. Maizz refuses live Paystack keys without it.
# Secret for the nightly check (24+ characters). Vercel sends it automatically to /api/cron/reconcile.
# CRON_SECRET=

# MAIZZ_ALLOW_LIVE=

# Church sign-in (step 9). STAFF_SECRET: a long random string, at least 32 characters. Never change it casually: it signs every stored code and session.
# STAFF_SECRET=
# Email sending for sign-in codes and invites (Resend). The key goes in Vercel only.
# RESEND_API_KEY=
# MAIZZ_FROM_EMAIL=Maizz <sign-in@your-verified-domain>
# REQUIRED on the live site: the public web address used in invite and reset links and QR codes, for example https://maizz-nu.vercel.app
# (no slash at the end, no path). Without it no such email is sent. The address a request came from is never trusted.
# MAIZZ_PUBLIC_URL=

# Alerts (step 10 prep). Where odd-event emails go. Needs the email settings above.
# ALERT_EMAIL=
# Optional: a gift at or above this many pesewas raises a "large gift" alert. Default 200000 (GH₵2,000).
# ALERT_LARGE_GIFT_PESEWAS=

# Security review group B. RATE_LIMIT_SECRET: a long random string, at least 32 characters, used to hide phone numbers
# and addresses inside the attempt counters. Set it in Vercel (Production, Sensitive). Never paste it anywhere else.
# REQUIRED on the live site: without it the giving page refuses gifts.
# RATE_LIMIT_SECRET=
# Content-Security-Policy starts in report-only mode. Set to "enforce" after a quiet week to make browsers block for real.
# MAIZZ_CSP=

# Third review. TOTP_KEY: a long random string, at least 32 characters, DIFFERENT from STAFF_SECRET. It locks the owner's
# authenticator-app secret and recovery codes, so changing STAFF_SECRET can never lock the owner out of the app.
# Set it in Vercel (Production, Sensitive) and keep a copy in your password manager. Losing it means setting the app up again.
# TOTP_KEY=
# Step 8, the Church Manager link. A long random string, at least 32 characters. Church keys are made from it, never stored.
# Set it in Vercel (Production, Sensitive) and keep a copy in your password manager. Changing it stops every church's link until each key is given to Church Manager again.
# MEMBER_LINK_MASTER_KEY=
# A mailbox Maizz owns. Used as the payer email when a giver gives none (the payment provider may send receipts to it).
# REQUIRED with a live key: gifts without an email are refused until it is set.
# PROVIDER_STAND_IN_EMAIL=

# Set to "yes" in EVERY Vercel environment that can reach the live database (Production, and Preview/Development if ticked).
# The old admin tools and setup page then stay off, even with MAIZZ_ADMIN_TOOLS=on. Never set it on the test project.
# MAIZZ_LIVE_DATABASE=
